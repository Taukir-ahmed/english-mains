{
  "name": "mains-english-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "validate": "node scripts/validate-data.mjs",
    "build": "npm run vocab:sync && npm run validate && vite build && node scripts/export-html.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "vocab:sync": "node scripts/sync-vocabulary.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}
